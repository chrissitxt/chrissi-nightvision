{
  "schemaVersion": 1,
  "id": "chrissi-nightvision",
  "version": "${version}",
  "name": "chrissi's Night Vision",
  "description": "A lightweight client-side mod that allows you to toggle the night vision effect with a keybind.",
  "authors": ["chrissi"],
  "contact": {
    "homepage": "https://chrissitxt.me/",
    "sources": "https://github.com/chrissitxt/chrissi-nightvision",
    "issues": "https://github.com/chrissitxt/chrissi-nightvision/issues"
  },
  "license": "MIT",
  "icon": "assets/chrissi-nightvision/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["chrissi.nightvision.NightVisionClient"],
    "modmenu": ["chrissi.nightvision.NightVisionModMenuIntegration"]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}